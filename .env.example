# Server
PORT=3001
# Production mode: also serves dist/ and enforces same-origin API access
# NODE_ENV=production

# Behind a reverse proxy (Render/Railway/nginx) set to 1 so rate limiting
# keys on the real client IP. Leave unset for direct local runs.
TRUST_PROXY=1

# Optional: extra origins allowed to call the API cross-origin (comma
# separated). Not needed when the site is served from the same Node process.
# ALLOWED_ORIGINS=https://your-domain.com

# SQLite database file location (override only for custom installs)
# DB_PATH=/var/data/community.db

# Contact form — email delivery via Resend. Required for /api/contact to
# actually send mail; without it the endpoint responds 503 with guidance.
RESEND_API_KEY=
CONTACT_EMAIL=tejaskhadse900@gmail.com
