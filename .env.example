# ---------------------------------------------------------------------------
# Tejas Portfolio — environment variables (complete list, audited)
#
# Copy to .env for local runs. Configure the same unprefixed email variables
# in Vercel's server environment; never put API keys in a VITE_* variable.
# ---------------------------------------------------------------------------

# ==== REQUIRED for local email delivery — server/contact-email.js ====
# Brevo Transactional Email API key — create one at
# https://app.brevo.com/settings/keys/api (SMTP & API → API keys). Without it
# /api/contact responds 503 with guidance; everything else keeps working.
# For production, configure this as an unprefixed Vercel server environment variable.
BREVO_API_KEY=

# ==== Email recipient ====
# Where contact-form emails are delivered.
CONTACT_EMAIL=tejaskhadse900@gmail.com
# Server port (default 3001 if unset).
PORT=3001
# Production mode: serves dist/ + enforces CORS/CSP + SPA fallback.
NODE_ENV=production
# Set to 1 behind Render/nginx so rate limiting keys on the real client IP.
TRUST_PROXY=1

# ==== LOCAL API ROUTING ====
# Optional Vite proxy target if the local backend is not on port 3001.
# API_PROXY_TARGET=http://127.0.0.1:3001

# ==== OPTIONAL ====
# Sender address for contact emails. Brevo requires the sender to be a
# validated sender in your account — the account email (CONTACT_EMAIL) is
# used by default. Set only if you validate a different sender there.
# CONTACT_FROM_EMAIL=

# SQLite database file location. On Render with the blueprint disk this must
# point inside the mounted disk (/var/data/community.db) or messages reset
# on every deploy. Locally, leaving it unset uses data/community.db.
# DB_PATH=/var/data/community.db

# Extra origins allowed to call the API cross-origin, comma-separated.
# Only needed for split front-end/back-end hosting. Use the exact frontend
# origin, e.g. https://tejas-portfolio-hazel.vercel.app.
# ALLOWED_ORIGINS=

# Destination directory for npm run backup (default: data/backups).
# BACKUP_DIR=/var/backups/portfolio
