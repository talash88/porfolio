# ---------------------------------------------------------------------------
# Tejas Portfolio — environment variables (complete list, audited)
#
# Copy to .env for local runs. Configure the same variables in Vercel's server
# environment; never put a secret into a VITE_* variable — VITE_* values are
# bundled into frontend JavaScript and visible to every visitor.
# ---------------------------------------------------------------------------

# ==== REQUIRED for contact email delivery — server/contact-email.js ====
# Brevo Transactional Email API key — create one at
# https://app.brevo.com/settings/keys/api (SMTP & API → API keys). Without it
# /api/contact responds 503 with guidance; everything else keeps working.
# Configure as an unprefixed Vercel server environment variable.
BREVO_API_KEY=

# ==== Email recipient ====
# Where contact-form emails are delivered.
CONTACT_EMAIL=tejaskhadse900@gmail.com

# ==== REQUIRED for the Developer Community (Supabase) ====
# Create a free project at https://supabase.com, run supabase/schema.sql in
# the SQL editor, then copy these from Project Settings → API.
#
# Public (bundled into the frontend, read-only via RLS — safe):
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Secret (server-side only — used by api/community/* to write messages):
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ==== Server (local Node backend / Render alternate deployment) ====
# Server port (default 3001 if unset).
PORT=3001
# Production mode: serves dist/ + enforces CORS/CSP + SPA fallback.
NODE_ENV=production
# Set to 1 behind Render/nginx so rate limiting keys on the real client IP.
TRUST_PROXY=1

# ==== LOCAL API ROUTING ====
# Optional Vite proxy target if the local backend is not on port 3001.
# API_PROXY_TARGET=http://127.0.0.1:3001

# ==== OPTIONAL ====
# Sender address for contact emails. Brevo requires the sender to be a
# validated sender in your account — the account email (CONTACT_EMAIL) is
# used by default. Set only if you validate a different sender there.
# CONTACT_FROM_EMAIL=

# SQLite database file location (used only by the optional local/Render
# fallback of the community chat without Supabase).
# DB_PATH=/var/data/community.db

# Extra origins allowed to call the API cross-origin, comma-separated.
# Only needed for split front-end/back-end hosting.
# ALLOWED_ORIGINS=

# Destination directory for npm run backup (default: data/backups).
# BACKUP_DIR=/var/backups/portfolio
