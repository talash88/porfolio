{
  "name": "tejas-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n vite,api -c cyan,magenta \"vite\" \"node server/index.js\"",
    "dev:server": "node server/index.js",
    "dev:full": "concurrently -k -n vite,api -c cyan,magenta \"vite\" \"node server/index.js\"",
    "start": "node server/index.js",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "backup": "node scripts/db-backup.mjs",
    "restore": "node scripts/db-restore.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.2.0",
    "@fontsource-variable/manrope": "^5.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.2",
    "oxlint": "^1.91.0",
    "playwright": "^1.64.1",
    "typescript": "~5.9.0",
    "vite": "^7.1.0"
  }
}
